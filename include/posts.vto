---
layout: main
main_class: h-feed column
tag: both
before: |
  {{ set first = [ "all", "posts", "notes" ] }}
  {{ set filtered = Object.fromEntries(Object.entries(collections).map(([k, v]) => [k, v.filter((e) => !e.data.draft)]).filter(([k, v]) => v.length > 0 && !first.includes(k) && k != "both" && k != "food")) }}
  {{ set other = Object.keys(filtered).sort((a, b) => filtered[b].length - filtered[a].length) }}
  {{ set allTags = first.concat(other) }}
  {{ set chips = allTags.map(t => ({ name: t, url: t === "all" ? "/" : `/tags/${t}`, primary: first.includes(t), current: page.url.includes(t) || (t === "all" && page.url === "/") })) }}
  {{ include "chips.vto" { chips, label: "Categories" } }}
---
{{
  set flower = "❄❅❈✼❉❊❋❃❁✾᪥❇".split("").map((v, i, a) =>
    ((r) => ([v, a[r]] = [a[r], v], v))(
      Math.floor(Math.random() * (a.length - i)) + i,
    )
  )
}}

{{ function render(post) }}
  {{ set note = post.filePathStem.includes("notes") }}
  {{ set z_note = note ? " z-note" : "" }}
  {{ set z_draft = post.data.draft ? " z-draft" : "" }}
  {{ set z_highlight = post.data.highlight ? " z-highlight" : "" }}
  <article class="h-entry column{{ z_note }}{{ z_draft }}{{ z_highlight }}" tabindex=0>
    {{ if post.data.title }}
      <h2 class="p-name" data-flower="{{ flower[i % flower.length] }}">
        <a class="u-url" href="{{ post.url }}">
          {{ post.data.title }}
        </a>
      </h2>
    {{ /if }}
    {{ if post.data.media?.length }}
      <div class="z-media">
        {{ for item of post.data.media }}
          {{ item |> safe }}
        {{ /for }}
      </div>
    {{ /if }}
    {{ if !post.data.title }}
      <a class="u-url" href="{{ post.url }}" hidden></a>
    {{ /if }}
    {{ if note && post.data.excerpts?.length }}
      <div class="z-excerpts">
        {{ for ex of post.data.excerpts }}
          <p class="p-summary">{{ ex |> safe }}</p>
        {{ /for }}
      </div>
    {{ else }}
      <p class="p-summary">{{ post.data.excerpt }}</p>
    {{ /if }}
    <span>
      <time class="dt-published">{{ post.date.toDateString() }}</time>
      ·
      {{ for tag of post.data.tags }}
        <a class="p-category" href="/tags/{{ tag }}">{{ tag }}</a>
      {{ /for }}
    </span>
  </article>
{{ /function }}

{{ set posts = collections[tag].toReversed().filter(p => !p.data.tags?.includes('food')) }}
{{ set i = 0 }}

{{ for post of posts.filter(p => p.data.highlight) }}
  {{ render(post) }}
  {{ set i = i + 1 }}
{{ /for }}

{{ if page.url === "/" }}
  {{ set foodImages = food.items.filter(i => i.type === 'image').slice(0, 5) }}
  {{ if foodImages.length > 0 }}
    <section class="z-food-row">
      <h2><a href="/food">food from plants</a></h2>
      <div class="z-food-images">
        {{ for item of foodImages }}
          <a href="/food" class="z-food-thumb" data-lightbox="{{ item.src }}" data-description="{{ item.description }}" data-date="{{ item.date.toDateString() }}">
            <img src="{{ item.thumb ?? item.src }}" alt="{{ item.description }}" loading="lazy">
          </a>
        {{ /for }}
      </div>
    </section>
  {{ /if }}
{{ /if }}

{{ for post of posts.filter(p => !p.data.highlight) }}
  {{ render(post) }}
  {{ set i = i + 1 }}
{{ /for }}

{{ include "lightbox.vto" }}

<script>
  document.querySelectorAll(".h-entry").forEach((entry) => {
    const link = entry.querySelector(".u-url");
    entry.addEventListener("click", (event) => {
      if (!window.getSelection().toString()) link.click();
    });
  });
</script>
